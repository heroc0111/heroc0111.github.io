---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';

const featured = projects[0];
const supporting = projects.slice(1);
---

<BaseLayout>
  <main>
    <section class="hero shell" id="top">
      <nav aria-label="Main navigation">
        <a class="wordmark" href="#top" aria-label="Hervé Roussel, home">HR<span>·</span></a>
        <a class="nav-work" href="#work">Selected work <span aria-hidden="true">↓</span></a>
        <a class="nav-contact" href="#contact">Start a conversation <span aria-hidden="true">↗</span></a>
      </nav>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Hervé Roussel / Singapore</p>
          <h1>I turn ambitious AI ideas into <em>working products.</em></h1>
          <p class="lede">Founder and engineering leader. I build practical AI products, complex workflows, and the teams that make them real.</p>
          <a class="button" href="#work">Explore my work <span>↓</span></a>
        </div>
        <div class="hero-meta" aria-label="Career highlights">
          <p>01 — NOW</p>
          <div class="orbital-mark" aria-hidden="true"><i></i><i></i><b>AI</b></div>
          <ul>
            <li>Founder &amp; CTO</li>
            <li>Engineering leader</li>
            <li>Hands-on builder</li>
          </ul>
        </div>
      </div>

      <div class="proof-strip">
        <span>10+ years building teams &amp; products</span>
        <span>1B+ messages processed</span>
        <span>250M+ API calls / month</span>
      </div>
    </section>

    <section class="work-section shell" id="work">
      <header class="section-heading">
        <p class="eyebrow"><span></span> 02 — SELECTED WORK</p>
        <h2>Proof, not promises.</h2>
        <p>A small set of AI product explorations. Each is designed to make a difficult business workflow more legible, useful, and human.</p>
      </header>

      <article class="featured-project">
        <div class={`project-visual ${featured.accent} ${featured.visual}`} aria-label={`Conceptual interface preview for ${featured.name}`}>
          <div class="browser-bar"><span></span><span></span><span></span><p>sentio.ai / research</p></div>
          <div class="product-ui signal-ui">
            <aside><b>S</b><i></i><i></i><i></i><i></i></aside>
            <div class="signal-content">
              <div class="ui-kicker">TECHNOLOGY LANDSCAPE</div>
              <div class="ui-title">Autonomous systems</div>
              <div class="signal-chart"><span></span><span></span><span></span><span></span><span></span><svg viewBox="0 0 370 115" preserveAspectRatio="none" aria-hidden="true"><path d="M0,88 C35,86 32,55 63,61 S102,80 129,49 S166,66 195,37 S232,57 260,28 S292,45 320,16 S351,28 370,5" /></svg></div>
              <div class="signal-cards"><div><b>14</b><small>emerging signals</small></div><div><b>8.6</b><small>market velocity</small></div><div><b>92%</b><small>source coverage</small></div></div>
            </div>
          </div>
          <span class="visual-caption">CONCEPTUAL PRODUCT VIEW</span>
        </div>
        <div class="project-copy">
          <p class="project-index">01 / FEATURED</p>
          <h3>{featured.name}</h3>
          <p class="project-tagline">{featured.eyebrow}</p>
          <p>{featured.summary}</p>
          <dl><div><dt>My role</dt><dd>{featured.contribution}</dd></div><div><dt>Format</dt><dd>Interactive product prototype</dd></div></dl>
          <a class="text-link" href={featured.videoUrl ?? '#contact'}>{featured.videoUrl ? 'Watch the 60-second walkthrough' : 'Request a walkthrough'} <span>↗</span></a>
        </div>
      </article>

      <div class="project-grid">
        {supporting.map((project, index) => (
          <article class="project-card">
            <div class={`project-visual compact ${project.accent} ${project.visual}`} aria-label={`Conceptual interface preview for ${project.name}`}>
              <div class="browser-bar"><span></span><span></span><span></span></div>
              {project.visual === 'diligence' && <div class="mini-ui diligence-ui"><div class="risk-score">72<span>/100</span></div><div class="bar-lines"><i></i><i></i><i></i><i></i></div><div class="flag"></div></div>}
              {project.visual === 'contract' && <div class="mini-ui contract-ui"><div class="paper"><i></i><i></i><i></i><i></i><i></i></div><div class="annotation a-one"></div><div class="annotation a-two"></div></div>}
              {project.visual === 'vision' && <div class="mini-ui vision-ui"><div class="camera-grid"></div><div class="target-box one"></div><div class="target-box two"></div><p>CAM 04 · LIVE</p></div>}
              <span class="visual-caption">CONCEPTUAL VIEW</span>
            </div>
            <div class="card-info">
              <p class="project-index">0{index + 2} / {project.status}</p>
              <h3>{project.name}</h3>
              <p class="project-tagline">{project.eyebrow}</p>
              <p>{project.summary}</p>
              <a class="text-link" href={project.videoUrl ?? '#contact'}>{project.videoUrl ? 'Watch the walkthrough' : 'Request a walkthrough'} <span>↗</span></a>
            </div>
          </article>
        ))}
      </div>
      <p class="disclaimer">The project panels are conceptual views of ongoing product explorations. They are not client work or production screenshots.</p>
    </section>

    <section class="experience shell" id="experience">
      <header class="section-heading">
        <p class="eyebrow"><span></span> 03 — EXPERIENCE &amp; OUTCOMES</p>
        <h2>Built from the inside out.</h2>
      </header>
      <div class="timeline">
        <article><p>2018—2022</p><div><h3>CTO &amp; co-founder <em>Quod AI</em></h3><p>Built and led an AI engineering organization, taking product and platform from early stage to scale.</p></div></article>
        <article><p>2016—2018</p><div><h3>Head of backend &amp; data engineering <em>Sentifi</em></h3><p>Led a distributed team of 20 on data-intensive systems and product delivery.</p></div></article>
        <article><p>2008—2013</p><div><h3>CTO &amp; co-founder <em>Linked Senior</em></h3><p>Built a healthcare technology company as a founder and technical operator.</p></div></article>
      </div>
    </section>

    <section class="help shell" id="help">
      <div class="help-title"><p class="eyebrow"><span></span> 04 — HOW I CAN HELP</p><h2>From the messy middle to a useful first version.</h2></div>
      <div class="help-list"><p><b>01</b> AI product prototyping</p><p><b>02</b> Complex workflow automation</p><p><b>03</b> Technical strategy</p><p><b>04</b> Engineering execution</p></div>
    </section>

    <footer class="footer shell" id="contact">
      <p class="eyebrow"><span></span> 05 — LET’S TALK</p>
      <h2>Let’s build something <em>useful.</em></h2>
      <div class="footer-bottom"><p>Have a problem worth working on? I’d love to hear about it.</p><div><a href="https://www.linkedin.com/in/hroussel/" target="_blank" rel="noreferrer">LinkedIn ↗</a></div></div>
      <p class="copyright">© {new Date().getFullYear()} Hervé Roussel · Built for thoughtful conversations.</p>
    </footer>
  </main>
</BaseLayout>
