---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';

const featured = projects[0];
const supporting = projects.slice(1);
---

<BaseLayout>
  <main>
    <section class="hero shell" id="top">
      <nav aria-label="Main navigation">
        <a class="wordmark" href="#top" aria-label="Hervé, home">H<span>·</span></a>
        <a class="nav-work" href="#work">Selected work <span aria-hidden="true">↓</span></a>
        <a class="nav-contact" href="#contact">Start a conversation <span aria-hidden="true">↗</span></a>
      </nav>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Hervé / Singapore</p>
          <h1>I turn ambitious AI ideas into <em>working products.</em></h1>
          <p class="lede">Founder, former CTO, and hands-on AI builder. I've built and exited a software company, developed early foundation models, and led engineering teams at scale. These days, I turn ideas into working AI products.</p>
          <a class="button" href="#work">Explore my work <span>↓</span></a>
        </div>
        <div class="hero-meta" aria-label="Career highlights">
          <p>01 — BUILDER PROFILE</p>
          <div class="orbital-mark" aria-hidden="true"><i></i><i></i><b>AI</b></div>
          <ul>
            <li>Founded &amp; exited</li>
            <li>Early code LLMs</li>
            <li>Still hands-on</li>
          </ul>
        </div>
      </div>

      <div class="proof-strip credentials">
        <span><b>Linked Senior</b>Co-founder · Acquired</span>
        <span><b>Quod AI</b>Co-founder · Early code LLMs</span>
        <span><b>Indeed</b>Engineering leader · 40+ engineers</span>
        <span><b>Public Sector</b>Large-scale AI &amp; digital products</span>
      </div>
    </section>

    <section class="work-section shell" id="work">
      <header class="section-heading">
        <p class="eyebrow"><span></span> 02 — SELECTED WORK</p>
        <h2>Proof, not promises.</h2>
        <p>Working products and prototypes I've built, from AI research agents to document intelligence and real-time operations.</p>
      </header>

      <article class="featured-project">
        <div class="project-visual video-frame" aria-label={`${featured.name} product walkthrough`}>
          <video controls preload="metadata" poster={featured.posterUrl}><source src={featured.videoUrl} type="video/mp4" /></video>
          <span class="visual-caption">REAL PRODUCT WALKTHROUGH · 42 SEC</span>
        </div>
        <div class="project-copy">
          <p class="project-index">01 / {featured.status}</p>
          <h3>{featured.name}</h3>
          <p class="project-tagline">{featured.eyebrow}</p>
          <p>{featured.summary}</p>
          <dl><div><dt>My role</dt><dd>{featured.contribution}</dd></div><div><dt>Format</dt><dd>Product walkthrough</dd></div></dl>
          <a class="text-link" href={featured.videoUrl}>Watch the 42-second walkthrough <span>↗</span></a>
        </div>
      </article>

      <div class="project-grid">
        {supporting.map((project, index) => (
          <article class="project-card">
            <div class="project-visual compact video-frame" aria-label={`${project.name} product walkthrough`}>
              <video controls preload="metadata" poster={project.posterUrl}><source src={project.videoUrl} type="video/mp4" /></video>
              <span class="visual-caption">REAL PRODUCT WALKTHROUGH</span>
            </div>
            <div class="card-info">
              <p class="project-index">0{index + 2} / {project.status}</p>
              <h3>{project.name}</h3>
              <p class="project-tagline">{project.eyebrow}</p>
              <p>{project.summary}</p>
              <a class="text-link" href={project.videoUrl}>Watch the walkthrough <span>↗</span></a>
            </div>
          </article>
        ))}
      </div>
      <p class="disclaimer">Walkthroughs, product imagery, and project descriptions are from Mildly AI’s public portfolio.</p>
    </section>

    <section class="experience shell" id="experience">
      <header class="section-heading">
        <p class="eyebrow"><span></span> 03 — EXPERIENCE &amp; OUTCOMES</p>
        <h2>Built from the inside out.</h2>
      </header>
      <div class="timeline">
        <article><p>Founder</p><div><h3>Co-founder &amp; CTO <em>Linked Senior</em></h3><p>Built and scaled a healthcare technology company to $1M ARR and 100+ enterprise customers, leading to an acquisition by LifeLoop.</p></div></article>
        <article><p>AI product</p><div><h3>Co-founder &amp; CTO <em>Quod AI</em></h3><p>Built early foundation models for source code before ChatGPT, growing the product to over 100,000 users.</p></div></article>
        <article><p>Leadership</p><div><h3>Senior Engineering Manager <em>Indeed</em></h3><p>Led 40+ engineers, improving engineering delivery and contributing to a global product initiative.</p></div></article>
        <article><p>Public technology</p><div><h3>Technology &amp; Product Consulting <em>Public Sector</em></h3><p>Led AI initiatives, large-scale product modernization, and multidisciplinary engineering teams delivering complex digital services.</p></div></article>
      </div>
    </section>

    <section class="help shell" id="help">
      <div class="help-title"><p class="eyebrow"><span></span> 04 — BUILD WITH ME</p><h2>Great products need great distribution.</h2><p>I’m exploring partnerships with people who understand audiences, customer acquisition, and growth. I bring product judgment, AI engineering, and the ability to build and operate software.</p></div>
      <div class="partnership-paths"><article><p class="path-label">For creators &amp; creator teams</p><h3>Turn audience insight into a product.</h3><p>You know your audience, what they care about, and the problems they face. I can help turn the right opportunity into a useful paid software product, handling development and technical operations.</p><p>We create something valuable for your audience and share in the upside.</p></article><article><p class="path-label">For growth marketers &amp; operators</p><h3>You bring growth. I bring the product.</h3><p>You’re great at identifying opportunities, positioning products, and acquiring customers. I bring the technical cofounder skill set: product strategy, AI engineering, and execution.</p><p>Let’s discover, build, and grow a niche software business together.</p></article></div>
    </section>

    <footer class="footer shell" id="contact">
      <p class="eyebrow"><span></span> 05 — LET’S TALK</p>
      <h2>Let’s build something people <em>want.</em></h2>
      <div class="footer-bottom"><p>If you’re a creator with an engaged audience, or a growth operator looking for a technical product partner, I’d love to compare notes.</p><div><a href="https://www.linkedin.com/in/hero0111/" target="_blank" rel="noreferrer">Connect on LinkedIn ↗</a><a href="mailto:hello@mildly.ai">Send me an email ↗</a><a href="https://mildly.ai/" target="_blank" rel="noreferrer">Mildly AI ↗</a></div></div>
      <p class="copyright">© {new Date().getFullYear()} Hervé · Built for thoughtful conversations.</p>
    </footer>
  </main>
</BaseLayout>
